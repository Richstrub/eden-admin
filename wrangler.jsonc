// Cloudflare settings: publish this folder as the staff website, plus a small worker (worker.js)
// that counts visits to the public website and receives catering questionnaires.
// The Supabase key below is the public "publishable" key (the same one in js/config.js).
// Never put a secret key here: INQUIRY_KEY, TURNSTILE_SECRET and RESEND_API_KEY are added as
// secrets in Cloudflare (Workers > eden-admin > Settings > Variables and Secrets). See README.
// SITE_URL is where guests' questionnaire links point (keep it the same as guestSite in js/config.js).
// STAFF_URL (optional) is this staff site's own address for links in the team's email notifications; without it they use the address the request came to.
{
  "name": "eden-admin",
  "compatibility_date": "2025-09-01",
  "main": "worker.js",
  // copies an INQUIRY_KEY saved in the Build settings into the worker (see scripts/inquiry-key.mjs)
  "build": { "command": "node scripts/inquiry-key.mjs" },
  "assets": { "directory": ".", "binding": "ASSETS" },
  "vars": {
    "SUPABASE_URL": "https://qmblccwyxbpvziiwrlne.supabase.co",
    "SUPABASE_KEY": "sb_publishable_Nbp1K_Co8tDVB-jNjBRs3w_D40qm4Mg",
    "SITE_URL": "https://edencny.com/",
    "STAFF_URL": "https://edencny-staff.com/",
    "MAIL_FROM": "Eden Events <events@edencny.com>",
    "NOTIFY_TO": "Tyler@edencny.com,Rich@edencny.com",
    // Pre-shift reads OpenTable's emails from this connected mailbox
    "OPENTABLE_MAILBOX": "rich@edencny.com"
  },
  // every 20 minutes the worker looks for today's OpenTable email (Pre-shift)
  "triggers": { "crons": ["*/20 * * * *"] },
  "keep_vars": true
}
