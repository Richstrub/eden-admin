// Cloudflare settings: publish this folder as the staff website, plus a tiny worker (worker.js)
// that counts visits to the public website for Analytics > Website traffic.
// The Supabase key below is the public "publishable" key (the same one in js/config.js).
// Never put a secret key here.
{
  "name": "eden-admin",
  "compatibility_date": "2025-09-01",
  "main": "worker.js",
  "assets": { "directory": ".", "binding": "ASSETS" },
  "vars": {
    "SUPABASE_URL": "https://qmblccwyxbpvziiwrlne.supabase.co",
    "SUPABASE_KEY": "sb_publishable_Nbp1K_Co8tDVB-jNjBRs3w_D40qm4Mg"
  }
}
